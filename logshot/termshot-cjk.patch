 func (s *Scaffold) SetFontFaceBoldItalic(face imgfont.Face) { s.boldItalic = face }
 
+// SetFontFile loads a single TTF/OTF font file and uses it for all four faces
+// (regular/bold/italic/bold-italic). This lets CJK and Nerd Font glyphs render
+// correctly, which the embedded Hack font cannot. Because we pass one file, the
+// bold/italic styles reuse the same face — fine for termshot's pixel output.
+// Hinting is forced to Full (when the font carries hint tables) so CJK glyphs
+// snap to the pixel grid and don't look blurry/soft.
+func (s *Scaffold) SetFontFile(path string, opts *truetype.Options) error {
+	bts, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("read font: %w", err)
+	}
+	parsed, err := truetype.Parse(bts)
+	if err != nil {
+		return fmt.Errorf("parse font: %w", err)
+	}
+	if opts == nil {
+		opts = &truetype.Options{}
+	}
+	opts.Hinting = imgfont.HintingFull
+	face := truetype.NewFace(parsed, opts)
+	s.regular = face
+	s.bold = face
+	s.italic = face
+	s.boldItalic = face
+	return nil
+}
+
